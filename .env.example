# OpenRouter API Configuration
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Specify which model to use
# Default: openai/gpt-4o-mini
# Must support structured outputs: https://openrouter.ai/models?supported_parameters=structured_outputs
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Public URL of your repository, shown as a GitHub link in the header.
# Not a secret — it is inlined into the client bundle. Leave unset to hide the link.
# NEXT_PUBLIC_REPO_URL=https://github.com/yourusername/codemedic
